<%- include('../partials/head') %>


</head>
<body class="bg-gray-900 text-gray-100 antialiased flex flex-col min-h-screen">

    <!-- Header / Logo -->
    <header class="p-6">
        <a href="/" class="text-3xl font-extrabold text-red-600 tracking-tighter">
            MFLIX<span class="text-white">.</span>
        </a>
    </header>

    <!-- Login Container -->
    <main class="flex-1 flex items-center justify-center px-4 pb-12">
        <div class="w-full max-w-md">
            
            <!-- Glassmorphism Card -->
            <div class="bg-gray-800/40 backdrop-blur-xl border border-gray-700/50 p-8 md:p-10 rounded-3xl shadow-2xl">
                
                <div class="mb-8 text-center">
                    <h1 class="text-3xl font-bold text-white mb-2">Welcome Back</h1>
                    <p class="text-gray-400 text-sm">Please enter your details to sign in.</p>
                </div>

                <form action="/login" method="POST" class="space-y-6">
                    
                    <!-- Email Field -->
                    <div class="space-y-2">
                        <label for="email" class="text-xs font-bold uppercase tracking-widest text-gray-400 ml-1">Email Address</label>
                        <div class="relative group">
                            <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-gray-500 group-focus-within:text-red-500 transition-colors">
                                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 12a4 4 0 10-8 0 4 4 0 008 0zm0 0v1.5a2.5 2.5 0 005 0V12a9 9 0 10-9 9m4.5-1.206a8.959 8.959 0 01-4.5 1.207" /></svg>
                            </div>
                            <input 
                                type="email" 
                                id="email" 
                                name="email" 
                                required 
                                placeholder="john@example.com"
                                class="w-full bg-gray-900/50 border border-gray-700 py-3.5 pl-12 pr-4 rounded-xl outline-none focus:border-red-600 focus:ring-1 focus:ring-red-600 transition-all text-sm"
                            >
                        </div>
                    </div>

                    <!-- Password Field -->
                    <div class="space-y-2">
                        <div class="flex justify-between items-center ml-1">
                            <label for="password" class="text-xs font-bold uppercase tracking-widest text-gray-400">Password</label>
                            <a href="#" class="text-[10px] font-bold text-red-500 hover:text-red-400 uppercase tracking-tighter transition-colors">Forgot?</a>
                        </div>
                        <div class="relative group">
                            <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-gray-500 group-focus-within:text-red-500 transition-colors">
                                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" /></svg>
                            </div>
                            <input 
                                type="password" 
                                id="password" 
                                name="password" 
                                required 
                                placeholder="••••••••"
                                class="w-full bg-gray-900/50 border border-gray-700 py-3.5 pl-12 pr-4 rounded-xl outline-none focus:border-red-600 focus:ring-1 focus:ring-red-600 transition-all text-sm"
                            >
                        </div>
                    </div>

                    <!-- Sign In Button -->
                    <button type="submit" class="w-full bg-red-600 hover:bg-red-700 text-white font-bold py-4 rounded-xl shadow-lg shadow-red-900/30 transform transition-all active:scale-[0.98] hover:scale-[1.01]">
                        Sign In
                    </button>
                </form>

                <!-- Footer Links -->
                <div class="mt-8 pt-6 border-t border-gray-700/50 text-center">
                    <p class="text-gray-400 text-sm">
                        Don't have an account? 
                        <a href="/signup" class="text-white font-bold hover:text-red-500 transition-colors underline underline-offset-4 decoration-red-600">Create Account</a>
                    </p>
                </div>

            </div>
            
            <!-- Legal/Help links -->
            <div class="mt-8 flex justify-center gap-6 text-[10px] uppercase tracking-widest text-gray-600 font-bold">
                <a href="#" class="hover:text-gray-400">Help</a>
                <a href="#" class="hover:text-gray-400">Privacy</a>
                <a href="#" class="hover:text-gray-400">Terms</a>
            </div>
        </div>
    </main>
</body>
</html>