<%- include('../partials/head')%>

<body class="bg-gray-900 text-gray-100 antialiased flex flex-col min-h-screen">

    <!-- Header / Logo -->
    <header class="p-6">
        <a href="/" class="text-3xl font-extrabold text-red-600 tracking-tighter">
            MFLIX<span class="text-white">.</span>
        </a>
    </header>

    <!-- Signup Container -->
    <main class="flex-1 flex items-center justify-center px-4 py-12">
        <div class="w-full max-w-md">
            
            <!-- Glassmorphism Card -->
            <div class="bg-gray-800/40 backdrop-blur-xl border border-gray-700/50 p-8 md:p-10 rounded-3xl shadow-2xl">
                
                <div class="mb-8 text-center">
                    <h1 class="text-3xl font-bold text-white mb-2">Create Account</h1>
                    <p class="text-gray-400 text-sm">Join the community and start streaming.</p>
                </div>

                <form action="/signup" method="POST" class="space-y-5">
                    
                    <!-- Full Name Field -->
                    <div class="space-y-2">
                        <label for="name" class="text-[10px] font-bold uppercase tracking-widest text-gray-500 ml-1">Full Name</label>
                        <div class="relative group">
                            <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-gray-500 group-focus-within:text-red-500 transition-colors">
                                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" /></svg>
                            </div>
                            <input 
                                type="text" 
                                id="name" 
                                name="name" 
                                required 
                                placeholder="John Bishop"
                                class="w-full bg-gray-900/50 border border-gray-700 py-3 pl-11 pr-4 rounded-xl outline-none focus:border-red-600 focus:ring-1 focus:ring-red-600 transition-all text-sm"
                            >
                        </div>
                    </div>

                    <!-- Email Field -->
                    <div class="space-y-2">
                        <label for="email" class="text-[10px] font-bold uppercase tracking-widest text-gray-500 ml-1">Email Address</label>
                        <div class="relative group">
                            <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-gray-500 group-focus-within:text-red-500 transition-colors">
                                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
                            </div>
                            <input 
                                type="email" 
                                id="email" 
                                name="email" 
                                required 
                                placeholder="john@example.com"
                                class="w-full bg-gray-900/50 border border-gray-700 py-3 pl-11 pr-4 rounded-xl outline-none focus:border-red-600 focus:ring-1 focus:ring-red-600 transition-all text-sm"
                            >
                        </div>
                    </div>

                    <!-- Password Field -->
                    <div class="space-y-2">
                        <label for="password" class="text-[10px] font-bold uppercase tracking-widest text-gray-500 ml-1">Password</label>
                        <div class="relative group">
                            <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-gray-500 group-focus-within:text-red-500 transition-colors">
                                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" /></svg>
                            </div>
                            <input 
                                type="password" 
                                id="password" 
                                name="password" 
                                required 
                                placeholder="••••••••"
                                class="w-full bg-gray-900/50 border border-gray-700 py-3 pl-11 pr-4 rounded-xl outline-none focus:border-red-600 focus:ring-1 focus:ring-red-600 transition-all text-sm"
                            >
                        </div>
                    </div>

                    <!-- Confirm Password -->
                    <div class="space-y-2 pb-2">
                        <label for="confirm-password" class="text-[10px] font-bold uppercase tracking-widest text-gray-500 ml-1">Confirm Password</label>
                        <div class="relative group">
                            <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-gray-500 group-focus-within:text-red-500 transition-colors">
                                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" /></svg>
                            </div>
                            <input 
                                type="password" 
                                id="confirm-password" 
                                name="confirmPassword" 
                                required 
                                placeholder="••••••••"
                                class="w-full bg-gray-900/50 border border-gray-700 py-3 pl-11 pr-4 rounded-xl outline-none focus:border-red-600 focus:ring-1 focus:ring-red-600 transition-all text-sm"
                            >
                        </div>
                    </div>

                    <!-- Register Button -->
                    <button type="submit" class="w-full bg-red-600 hover:bg-red-700 text-white font-bold py-3.5 rounded-xl shadow-lg shadow-red-900/30 transform transition-all active:scale-[0.98] hover:scale-[1.01] mt-2 text-sm uppercase tracking-widest">
                        Create Account
                    </button>
                </form>

                <!-- Footer Links -->
                <div class="mt-8 pt-6 border-t border-gray-700/50 text-center">
                    <p class="text-gray-400 text-xs">
                        Already have an account? 
                        <a href="/login" class="text-white font-bold hover:text-red-500 transition-colors underline underline-offset-4 decoration-red-600">Sign In</a>
                    </p>
                </div>

            </div>
        </div>
    </main>

    <!-- Simple Footer -->
    <footer class="p-6 text-center text-[10px] text-gray-600 font-bold uppercase tracking-[0.2em]">
        &copy; 2026 MFLIX Studio. All rights reserved.
    </footer>
</body>
</html>