<%- include('../partials/head') %>
<body class="bg-gray-900 text-gray-100 antialiased">

    <!-- Search Bar Section -->
    <%- include('../partials/searchbar') %>

    <!-- Main Content -->
    <main class="max-w-7xl mx-auto px-6 pb-12">
        <h1 class="text-center text-4xl text-white mb-6"> List Searched Items.</h1>
        <% if (movies && movies.length > 0) { %>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                <% movies.forEach(movie => { %>
                    <%- include('../partials/movieCard', {movie : movie})%>
                <% }); %>
            </div>
        <% } else { %>
            <div class="text-center py-32 bg-gray-800/20 rounded-3xl border border-dashed border-gray-700">
                <p class="text-gray-500 text-xl italic font-light">No movies found in the vault.</p>
                <button onclick="window.location.reload()" class="mt-4 text-red-500 hover:underline text-sm font-bold uppercase tracking-widest">Clear Search</button>
            </div>
        <% } %>
    </main>

    <%- include('../partials/footer') %>
</body>
</html>