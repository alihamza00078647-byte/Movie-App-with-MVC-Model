<%- include('../partials/head') %>

<body class="bg-gray-900 text-gray-100">
    <!-- Header -->
    <header class="border-b border-gray-800 pb-4 pt-8 px-8">
        <div class="flex justify-between items-center">
            <a href="/" class="text-red-600 hover:text-red-400 transition-colors">
                <h1 class="text-3xl font-bold tracking-tighter md:inline">MFLIX<span class="text-white">.</span></h1>
            </a>
            <%- include('../partials/searchbar') %>
            <div>
                <h1 class="text-2xl font-bold text-red-600 tracking-tighter hidden md:inline">Account</h1>
            </div>
        </div>
    </header>

    <!-- Movie Details -->
    <main class="px-8 py-12">
        <div class="max-w-6xl mx-auto">
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
                <!-- Poster -->
                <div class="lg:col-span-1">
                    <div class="sticky top-8">
                        <img src="<%= movie.poster %>" alt="<%= movie.title %>" class="w-full rounded-xl shadow-2xl">
                        <div class="mt-4 flex items-center gap-4">
                            <div class="bg-gray-800 px-4 py-2 rounded-lg">
                                <span class="text-yellow-400 font-bold">⭐ <%= movie.imdb.rating %></span>
                                <span class="text-gray-400 text-sm">/10</span>
                            </div>
                            <% if (movie.tomatoes && movie.tomatoes.viewer) { %>
                                <div class="bg-gray-800 px-4 py-2 rounded-lg">
                                    <span class="text-green-400 font-bold"><%= movie.tomatoes.viewer.meter %></span>
                                    <span class="text-gray-400 text-sm">Fresh</span>
                                </div>
                            <% } %>
                        </div>
                    </div>
                </div>

                <!-- Details -->
                <div class="lg:col-span-2">
                    <div class="space-y-6">
                        <!-- Title and Basic Info -->
                        <div>
                            <h1 class="text-4xl font-bold mb-2"><%= movie.title %></h1>
                            <div class="flex flex-wrap items-center gap-4 text-gray-400">
                                <span class="text-xl"><%= movie.year %></span>
                                <span class="text-lg"><%= movie.rated %></span>
                                <span class="text-lg"><%= movie.runtime %> min</span>
                            </div>
                        </div>

                        <!-- Genres -->
                        <div class="flex flex-wrap gap-2">
                            <% movie.genres.forEach(genre => { %>
                                <span class="bg-red-600 text-white px-3 py-1 rounded-full text-sm font-medium">
                                    <%= genre %>
                                </span>
                            <% }); %>
                        </div>

                        <!-- Plot -->
                        <div>
                            <h2 class="text-2xl font-bold mb-3">Plot</h2>
                            <p class="text-gray-300 leading-relaxed"><%= movie.plot %></p>
                        </div>

                        <!-- Cast -->
                        <% if (movie.cast && movie.cast.length > 0) { %>
                            <div>
                                <h2 class="text-2xl font-bold mb-3">Cast</h2>
                                <div class="flex flex-wrap gap-2">
                                    <% movie.cast.forEach(actor => { %>
                                        <span class="bg-gray-800 text-gray-300 px-3 py-1 rounded-lg text-sm">
                                            <%= actor %>
                                        </span>
                                    <% }); %>
                                </div>
                            </div>
                        <% } %>

                        <!-- Director -->
                        <% if (movie.directors && movie.directors.length > 0) { %>
                            <div>
                                <h2 class="text-2xl font-bold mb-3">Director<%= movie.directors.length > 1 ? 's' : '' %></h2>
                                <p class="text-gray-300"><%= movie.directors.join(', ') %></p>
                            </div>
                        <% } %>

                        <!-- Writers -->
                        <% if (movie.writers && movie.writers.length > 0) { %>
                            <div>
                                <h2 class="text-2xl font-bold mb-3">Writer<%= movie.writers.length > 1 ? 's' : '' %></h2>
                                <p class="text-gray-300"><%= movie.writers.join(', ') %></p>
                            </div>
                        <% } %>

                        <!-- Additional Info -->
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 pt-6 border-t border-gray-800">
                            <% if (movie.languages && movie.languages.length > 0) { %>
                                <div>
                                    <h3 class="text-lg font-semibold mb-2">Languages</h3>
                                    <p class="text-gray-400"><%= movie.languages.join(', ') %></p>
                                </div>
                            <% } %>
                            <% if (movie.countries && movie.countries.length > 0) { %>
                                <div>
                                    <h3 class="text-lg font-semibold mb-2">Countries</h3>
                                    <p class="text-gray-400"><%= movie.countries.join(', ') %></p>
                                </div>
                            <% } %>
                            <% if (movie.awards && movie.awards.text) { %>
                                <div class="md:col-span-2">
                                    <h3 class="text-lg font-semibold mb-2">Awards</h3>
                                    <p class="text-gray-400"><%= movie.awards.text %></p>
                                </div>
                            <% } %>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="max-w-7xl mx-auto px-4 mt-12">
            <!-- Header with a little more style -->
            <div class="flex items-center gap-4 mb-6">
                <h1 class="text-3xl font-extrabold text-white tracking-tighter uppercase italic">Official Trailer</h1>
                <div class="h-1 flex-grow bg-gradient-to-r from-red-600 to-transparent rounded-full"></div>
            </div>

            <!-- The Video Container -->
            <div class="relative group overflow-hidden rounded-xl border-2 border-gray-800 bg-black shadow-2xl shadow-red-900/20">
                <video 
                    src="/videos/Elbaph_Arc_Official_Trailer_ONE_PIECE.mp4"
                    loop
                    controls
                    class="w-full aspect-video object-cover"
                >
                    Your browser does not support the video tag.
                </video>
                
                <!-- Subtle Overlay for "Theater" feel -->
                <div class="absolute inset-0 pointer-events-none ring-1 ring-inset ring-white/10 rounded-xl"></div>
            </div>
        </div>
        <div class="flex items-center gap-4 mb-8 mt-16">
            <h1 class="text-3xl font-extrabold text-white tracking-tighter uppercase italic">You may Also like</h1>
            <div class="h-1 flex-grow bg-gradient-to-r from-red-600 to-transparent rounded-full"></div>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            <% movies.forEach(movie => { %>
                <%- include('../partials/movieCard', {movie : movie}) %>
            <% }); %>
        </div>
        <% comment.forEach(({name, email, text}) => { %>
            <%- include('../partials/comments', {name, email, text}) %>
        <% }); %>
    </main>

    <%- include('../partials/footer') %>
</body>
</html>