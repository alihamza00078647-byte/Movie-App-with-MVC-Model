<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://cdn.tailwindcss.com"></script>
    <title>Movie App</title>
</head>
<body class="bg-gray-900 text-gray-100 p-8">

    <header class="mb-10 border-b border-gray-800 pb-4 border-2 flex justify-between items-center">

        <h1 class="text-4xl font-bold text-red-600 tracking-tighter">MFLIX<span class="text-white hidden md:inline">.</span></h1>
        <%- include('../partials/searchbar')%>
        <div>
            <h1 class="text-4xl font-bold text-red-600 tracking-tighter">Account</h1>
        </div>
    </header>

    <% if (movies && movies.length > 0) { %>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            <% movies.forEach(movie => { %>
                <!-- Movie Card -->
                <%- include('../partials/movieCard', {movie : movie})%>
            <% }); %>
        </div>
    <% } else { %>
        <div class="text-center py-20">
            <p class="text-gray-500 text-xl text-italic">No movies found in the vault.</p>
        </div>
    <% } %>
    <%- include('../partials/footer') %>
</body>
</html>